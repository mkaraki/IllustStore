APP_NAME=IllustStore
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:7090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sentry_logs
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=illustStore
DB_USERNAME=illustStore
DB_PASSWORD=illustStore

SESSION_DRIVER=memcached
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=memcached
CACHE_PREFIX=imageviewer-cache://

MEMCACHED_HOST=memcached

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=""
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true
SENTRY_ENVIRONMENT="${APP_ENV}"

SENTRY_VUE_DSN="${SENTRY_LARAVEL_DSN}"

ILLUST_STORE_IMAGE_SERVER_BASE_URL=http://localhost:7092/
